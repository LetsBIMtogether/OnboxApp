<Project Sdk="Microsoft.NET.Sdk">
	
	<PropertyGroup>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
	</PropertyGroup>
	
	<!-- Disable warnings -->
	<!--
	<PropertyGroup>
		<NoWarn>$(NoWarn);CS1591;CS8019;CS0618;CS0168;CS0219</NoWarn>
		<WarningsAsMessages>$(WarningsAsMessages);*</WarningsAsMessages>
	</PropertyGroup>
	-->
	
	<!-- Disable editorconfig -->
	<!--	
	<PropertyGroup>
		<GenerateMSBuildEditorConfigFile>false</GenerateMSBuildEditorConfigFile>
	</PropertyGroup>
	-->

	<!-- Per TF intermediate paths (avoids two targets writing the same file) -->
	<PropertyGroup>
		<IntermediateOutputPath>obj\$(Configuration)\$(TargetFramework)\</IntermediateOutputPath>
		<AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>true</AppendRuntimeIdentifierToOutputPath>
	</PropertyGroup>

	<PropertyGroup>
		<Configurations>Debug;Debug One;Release</Configurations>
		<Platforms>x64</Platforms>
		<OutputType>Library</OutputType>
		<RootNamespace>ONBOXAppl</RootNamespace>
		<AssemblyName>ONBOXAppl</AssemblyName>
		<RuntimeIdentifiers>win</RuntimeIdentifiers>

		<TargetFrameworks>net47;net48;</TargetFrameworks>	<!--net8.0-windows; -->	
		<RevitVersion Condition=" '$(RevitVersion)' == '' ">2024</RevitVersion>
		<DefineConstants>REVIT$(RevitVersion)</DefineConstants><!--;WINFORMS-->
		<PreprocessorDefinitions>$(DefineConstants)</PreprocessorDefinitions>
		
		<PlatformTarget>x64</PlatformTarget>
		<ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
		<EnableDefaultItems>false</EnableDefaultItems>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<OutputPath>..\bin\$(Configuration)\$(RevitVersion)</OutputPath>
		<BuildInParallel>false</BuildInParallel>
	</PropertyGroup>

	<!-- Only for .NET Framework targets -->
	<PropertyGroup Condition="'$(TargetFramework)' == 'net47' or '$(TargetFramework)' == 'net48'">
		<DebugEngines>{351668CC-8477-4fbf-BFE3-5F1006E4DB1F}</DebugEngines>
	</PropertyGroup>

	<!-- CoreCLR targets: don't force a Desktop CLR engine -->
	<PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
		<UseManagedCoreDebugger>true</UseManagedCoreDebugger>
	</PropertyGroup>
	
	<!-- Map Revit versions to .NET frameworks -->
	
	<PropertyGroup Condition="'$(TargetFramework)' == 'net47'">
		<RevitVersion>2019</RevitVersion>
		<OutputPath>..\bin\$(Configuration)\$(RevitVersion)</OutputPath>
	</PropertyGroup>
	
	<PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
		<RevitVersion>2026</RevitVersion>
		<UseWPF>true</UseWPF>
		<OutputPath>..\bin\$(Configuration)\$(RevitVersion)</OutputPath>
	</PropertyGroup>
	
	<!-- Debug One configuration targets net48 for a single Revit version (e.g., 2024) -->
	<PropertyGroup Condition="'$(Configuration)' == 'Debug One'">
		<TargetFrameworks>net8.0-windows</TargetFrameworks>
	</PropertyGroup>
	
	<!-- Debug-specific settings -->
	<PropertyGroup Condition="$(Configuration.Contains('Debug'))">
		<DefineConstants>$(DefineConstants);DEBUG</DefineConstants>
		<DebugType>full</DebugType>
		<DebugSymbols>true</DebugSymbols>
	</PropertyGroup>
	
	<!-- Release-specific settings -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<Optimize>true</Optimize>
		<DebugType>pdbonly</DebugType>
	</PropertyGroup>
	
